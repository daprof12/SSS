// Cloudflare Workers config for this app (built with the OpenNext adapter: npm run cf:build).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sss-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Custom domains on the sssng.online zone (active in Cloudflare).
  "routes": [
    { "pattern": "sssng.online", "custom_domain": true },
    { "pattern": "www.sssng.online", "custom_domain": true }
  ]
}
