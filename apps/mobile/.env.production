# Production addresses, compiled into the browser bundle by `next build`.
# Not secrets. A variable set in the build environment (Cloudflare, Docker build args) overrides these.
NEXT_PUBLIC_API_URL=https://api.sssng.online
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.sssng.online
# Public demo: show the demo accounts and test checkout while SMS and payments are mocked
# on the API. Remove before real users arrive (with the API on real Termii and Paystack keys).
NEXT_PUBLIC_DEMO=1
