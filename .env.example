# Every setting the API and the two web apps read, in one place.
#
# This file is a reference with placeholder values. It is safe to commit; a real .env is not
# (it is in .gitignore). Nothing here is needed for local development: every setting has a
# development default, shown as the value or noted in the comment.
#
# The API does not load a .env file by itself. To use one locally:
#   cp .env.example .env    then edit .env, and start the API with
#   cd apps/api && npx tsx --env-file=../../.env src/main.ts
# In production the values come from the host: Kubernetes secrets, Cloudflare, or the
# server's environment.

# ───────────────────────── API: required in production ─────────────────────────
# The API refuses to start with NODE_ENV=production unless these are set.

NODE_ENV=development                # development | test | production

# PostgreSQL 16 with PostGIS. Local default is the Docker database from `npm run db:up`.
DATABASE_URL=postgres://erp:erp_local_only@localhost:54329/erp

# Signs sign-in tokens. At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-random-characters

# Protects one-time codes if the database leaks. At least 32 characters, different from JWT_SECRET.
OTP_SECRET=change-me-a-different-32-character-secret

# Paystack secret key (sk_live_…). A test key (sk_test_…) is refused in production
# unless PAYSTACK_ALLOW_TEST=1, which is for a staging server only.
PAYSTACK_SECRET=sk_test_mock
# PAYSTACK_ALLOW_TEST=1

# SMS for sign-in codes. "mock" in development; production needs termii and its keys.
SMS_PROVIDER=mock
# TERMII_API_KEY=
# TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com

# Web push (officer offers, alerts). Generate a pair with: npx web-push generate-vapid-keys
# Without them development uses a mock outbox.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# ───────────────────────── API: addresses ─────────────────────────

PORT=4000

# The API's own public address (used in links it hands out).
PUBLIC_BASE_URL=http://localhost:4000

# Where Paystack sends people back after paying.
APP_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

# Web origins allowed to call the API, comma-separated. Production allows none unless listed.
# Development allows any localhost port.
# CORS_ORIGINS=https://app.example.com,https://dashboard.example.com

# ───────────────────────── API: optional ─────────────────────────

# Help assistant. With a key it uses Anthropic; without one, a built-in mock.
# ANTHROPIC_API_KEY=
# ASSISTANT_PROVIDER=anthropic

# Road routing server (OSRM-compatible) for officer travel times.
# Development uses the public OSRM demo server; production estimates unless this is set.
# ROUTING_URL=

# Dev-only endpoints under /dev (seed data, test tokens). On by default outside production;
# set 0 to turn off. Production refuses to start with DEV_TOOLS=1.
# DEV_TOOLS=0

# Timings, in milliseconds. The defaults are right for production.
# CANCEL_WINDOW_MS=5000             # free-cancel window after a report is sent
# SWEEP_MS=5000                     # how often overdue incident steps are checked
# PUSH_POLL_MS=1500                 # how often pending push notifications are sent

# Tests use their own database, never the development one.
# TEST_DATABASE_URL=postgres://erp:erp_local_only@localhost:54329/erp_test

# ───────────────────────── Web apps (dashboard and citizen app) ─────────────────────────
# NEXT_PUBLIC_* values are compiled into the browser bundle when the app is built, so they
# are public, never secrets, and changing one needs a rebuild. Production values live in
# apps/dashboard/.env.production and apps/mobile/.env.production.

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Citizen app only: where the "staff sign in" link on the landing page goes.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Citizen app only: the short code reports are texted to when there is no data connection.
# NEXT_PUBLIC_SMS_NUMBER=32123

# Map tile servers ({z}/{y}/{x} URLs). The defaults are Esri's public tiles.
# NEXT_PUBLIC_TILES_MAP=
# NEXT_PUBLIC_TILES_SATELLITE=
